# === OpenAI ===
OPENAI_API_KEY=sk-...

# === Airtable (optional — agent works without, skips enrichment) ===
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=app...
AIRTABLE_DRIVERS_TABLE=Drivers
AIRTABLE_CUSTOMERS_TABLE=Customers
AIRTABLE_JOBS_TABLE=Jobs

# === Make.com (optional — posts full result to webhook) ===
MAKE_WEBHOOK_URL=https://hook.us1.make.com/your-hook-id-here

# === Twilio (optional — enables SMS delivery) ===
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# === Model selection ===
WHISPER_MODEL=whisper-1
GPT_MODEL=gpt-4o
